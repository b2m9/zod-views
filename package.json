    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "typescript": "6.0.3",
    "vite-plus": "catalog:",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.7.0"
}
