{
  "name": "@b2m9/zod-views",
  "version": "0.1.0",
  "description": "Derive safe create, update, and read schemas from one Zod object.",
  "keywords": [
    "api",
    "patch",
    "schema",
    "typescript",
    "validation",
    "views",
    "zod"
  ],
  "homepage": "https://github.com/b2m9/zod-views#readme",
  "bugs": {
    "url": "https://github.com/b2m9/zod-views/issues"
  },
  "license": "MIT",
  "author": "Bob Massarczyk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b2m9/zod-views.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "check": "vp check",
